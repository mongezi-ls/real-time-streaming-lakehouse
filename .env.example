# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_KRAKEN=kraken.trades

# Kraken WebSocket
KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_SYMBOLS=BTC/USD,ETH/USD,SOL/USD

# Postgres (Airflow metadata)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Delta paths
BRONZE_PATH=data/bronze/kraken_trades
SILVER_PATH=data/silver/kraken_trades
GOLD_PATH=data/gold/kraken_trades

# Airflow
AIRFLOW_UID=50000

# Databricks (set the real token in your .env)
DBT_DATABRICKS_TOKEN=your-databricks-personal-access-token-here
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com